rules_version = '2';

// MF Soluções CRM — Firestore Rules V1.0 Seguro
// Auditado em: 2026-06-04
//
// PRINCÍPIO:
//   - CRM (usuário autenticado) pode ler e escrever tudo
//   - Landing/Calculadora (público) pode APENAS criar novos documentos
//     nas coleções designadas, com campos válidos
//   - Ninguém público pode ler, listar, atualizar ou deletar
//
// PROTEÇÕES:
//   - leads: acesso restrito ao CRM (auth obrigatória)
//   - lp_leads: create público com validação de campos; resto = auth
//   - eventos: create público com validação; resto = auth
//   - landing_visits: create público; resto = auth
//   - tudo mais: auth obrigatória

service cloud.firestore {
  match /databases/{database}/documents {

    // ── leads (Calculadora/CRM) ─────────────────────────────────
    // Apenas usuários autenticados do CRM.
    // A calculadora envia leads já autenticada com o uid do admin.
    match /leads/{leadId} {
      allow read, write: if request.auth != null;
    }

    // ── lp_leads (Landing Page) ─────────────────────────────────
    // Visitantes podem CRIAR um lead (formulário da Landing).
    // Apenas auth pode ler, atualizar ou deletar.
    // Validação: ao menos um campo de identificação deve existir.
    match /lp_leads/{leadId} {
      allow create: if
        // Campos mínimos obrigatórios
        (request.resource.data.keys().hasAny(['nome', 'telefone', 'sessionId'])) &&
        // Tamanho razoável (evita documentos gigantes)
        request.resource.data.size() < 100;

      allow read, update, delete: if request.auth != null;
    }

    // ── eventos (Calculadora / Landing tracking) ────────────────
    // Visitantes podem CRIAR eventos de rastreamento.
    // Apenas auth pode ler ou deletar.
    // Validação: campo 'evento' obrigatório + sessionId.
    match /eventos/{eventoId} {
      allow create: if
        request.resource.data.keys().hasAll(['evento', 'sessionId']) &&
        request.resource.data.evento is string &&
        request.resource.data.evento.size() < 100 &&
        request.resource.data.size() < 50;

      allow read, update, delete: if request.auth != null;
    }

    // ── landing_visits (QR Code / visitas) ──────────────────────
    // Visitantes podem registrar visitas (QR code físico).
    // Apenas auth pode ler.
    match /landing_visits/{visitId} {
      allow create: if
        request.resource.data.size() < 50;

      allow read, update, delete: if request.auth != null;
    }

    // ── returno_ao_site ─────────────────────────────────────────
    // Dados de retorno ao site — leitura pública, escrita auth.
    match /returno_ao_site/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── instalacoes ─────────────────────────────────────────────
    match /instalacoes/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── financeiro_dados ────────────────────────────────────────
    match /financeiro_dados/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── crm_config ──────────────────────────────────────────────
    match /crm_config/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── Fallback global ─────────────────────────────────────────
    // Qualquer outra coleção não listada: somente auth.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}
